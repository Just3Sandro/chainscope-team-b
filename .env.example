# ChainScope V2 — exemple de configuration (racine du dépôt).
# COPIER VERS `.env` pour la dev locale ; docker-compose passe ces variables
# aux conteneurs. Valeurs fictives / explicatives uniquement : AUCUN secret
# réel ici (spec §3.1, D-14, D-16).
#
# Toutes les variables ci-dessous sont lues par `backend/app/config.py`
# (classe `Settings`, pydantic-settings). Les valeurs vides = défauts de
# Settings ; l'origine de chaque valeur par défaut est citée.

# --- Environnement -----------------------------------------------------------
# dev | production (choix : `production` masque /docs et force le cookie Secure)
ENV=dev

# Postgres 16. Hôte `postgres` dans docker-compose ; 127.0.0.1 pour un
# Postgres local (conteneur de dev). Mot de passe `CHANGE_ME` à remplacer
# (dev locale sans Docker) ; le compose de dev utilise POSTGRES_PASSWORD ci-dessous.
DATABASE_URL=postgresql://chainscope:CHANGE_ME@postgres:5432/chainscope

# Volume local privé des preuves (D-09) : /data/evidence dans le conteneur.
# Défaut Settings : data/evidence
EVIDENCE_DIR=/data/evidence

# --- SMTP (D-12) -------------------------------------------------------------
# Mailpit dans le compose de dev. Laisser SMTP_HOST vide en dev minimale :
# le transport "log" DEV-EMAIL s'active alors (interdit si ENV=production).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# --- Cookie de session (D-04) ------------------------------------------------
# Nom du cookie (défaut Settings : cs_session ; HttpOnly, SameSite=Lax).
# SESSION_COOKIE_NAME=cs_session
# SESSION_COOKIE_SECURE : défaut = dérivé de ENV (true si production).
# Surcharge explicite possible (true/false) ; laisser vide pour le défaut.
# SESSION_COOKIE_SECURE=
# Durée de vie de session (heures) — défaut Settings : 12 (spec §8 : sessions
# révocables à la déconnexion et au changement de mot de passe).
# SESSION_LIFETIME_HOURS=12

# --- Bootstrap administrateur plateforme (D-14) ------------------------------
# Au premier démarrage (si aucune ligne platform_admins), ces variables créent
# le superadministrateur. Laisser vide pour utiliser la CLI explicite :
#   python -m app.cli create-platform-admin --email <e> --password <p>
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Rate limiting (D-07 : fenêtre glissante, anti-enumeration) --------------
# S'applique à POST /auth/login, /auth/forgot-password, /auth/reset-password
# et /auth/accept-invitation. Défauts Settings : 5 requêtes / 60 s.
# STATE NON PARTAGÉ entre instances (mono-instance livrée, D-07).
# RATE_LIMIT_MAX_REQUESTS=5
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Upload de preuves (D-08, spec §4) ---------------------------------------
# Taille max : 10 Mio = 10485760 octets (au-delà : 413, rien stocké).
# Défaut Settings : 10485760
# UPLOAD_MAX_BYTES=10485760

# --- Densité du graphe (spec §4, D-10) ---------------------------------------
# Plafonds par engagement (création : 422/400 explicite au-delà).
# Défauts Settings : 150 actifs, 300 edges.
# MAX_ASSETS_PER_ENGAGEMENT=150
# MAX_EDGES_PER_ENGAGEMENT=300
# Budget d'exploration DFS (expansions) ; au-delà : 422 GRAPH_TOO_COMPLEX.
# Défaut Settings : 50000
# GRAPH_EXPANSION_BUDGET=50000

# --- Pagination (D-11, spec §6 : ?limit=20&offset=0) -------------------------
# Défauts Settings : limit 20, max 100 (422 au-delà de 100).
# PAGINATION_DEFAULT_LIMIT=20
# PAGINATION_MAX_LIMIT=100

# --- Validité des jetons (spec §8 : usage unique, expiration courte) ---------
# Invitations : défaut Settings : 24 h.
# INVITATION_LIFETIME_HOURS=24
# Réinitialisation de mot de passe : défaut Settings : 30 min.
# PASSWORD_RESET_LIFETIME_MINUTES=30

# --- Docker Compose de dev (issue #16) ----------------------------------------
# Valeurs FICTIVES, DEV UNIQUEMENT : jamais de secret réel ici (spec §3.1, D-14).
# Mot de passe du conteneur `postgres` (défaut si absent : devfictional).
POSTGRES_PASSWORD=devfictional

# Ports côté HÔTE du compose (défauts = ports standards). MODE DÉCALÉ : si des
# conteneurs de dev cs-* occupent déjà 5432/8025/1025 sur la machine (dev
# partagée), décalez par exemple dans un `.env` local (jamais commité) :
#   POSTGRES_PORT=15432
#   MAILPIT_UI_PORT=18025
#   MAILPIT_SMTP_PORT=11025
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Base publique de l'UI (liens des e-mails, D-12) : doit correspondre au port
# frontend du compose (FRONTEND_PORT=8080 par défaut ; à mettre à jour si
# FRONTEND_PORT est décalé).
PUBLIC_BASE_URL=http://localhost:8080
