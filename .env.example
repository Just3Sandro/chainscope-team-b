# ChainScope V2 — exemple de configuration (racine du dépôt).
# COPIER VERS `.env` pour la dev locale ; docker-compose passe ces variables
# aux conteneurs. Valeurs fictives / explicatives uniquement : AUCUN secret
# réel ici (spec §3.1, D-14, D-16).

# Environnement : dev | production
ENV=dev

# Postgres 16. Hôte `postgres` dans docker-compose ; 127.0.0.1 pour un
# Postgres local (conteneur de dev). Mot de passe `CHANGE_ME` à remplacer.
DATABASE_URL=postgresql://chainscope:CHANGE_ME@postgres:5432/chainscope

# Volume local privé des preuves (D-09) : /data/evidence dans le conteneur.
EVIDENCE_DIR=/data/evidence

# SMTP (Mailpit dans le compose de dev). Laisser SMTP_HOST vide en dev
# minimale : le transport "log" DEV-EMAIL s'active alors (interdit si
# ENV=production — D-12).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Bootstrap de l'administrateur plateforme au premier démarrage (D-14).
# Laisser vide pour utiliser la CLI explicite :
#   python -m app.cli create-platform-admin --email <e> --password <p>
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
